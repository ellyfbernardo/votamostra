MONGODB_URI=mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net/
OPENCAGE_API_KEY=sua-chave-da-opencage

# Senha do painel /admin (abrir/encerrar votações e acompanhar os votos).
# Use uma senha forte; trocar a senha desconecta quem estiver logado.
ADMIN_SENHA=troque-esta-senha

# Modo de teste: voto sem localização e sem OpenCage. Fora da produção, salva no
# banco separado "mostra-2026-teste". No site oficial (Vercel Production) os votos
# vão SEMPRE para o banco oficial "mostra-2026".
# VOTACAO_MODO_TESTE=true
