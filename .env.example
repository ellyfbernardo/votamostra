MONGODB_URI=mongodb+srv://usuario:senha@cluster.exemplo.mongodb.net/
OPENCAGE_API_KEY=sua-chave-da-opencage

# Para testar a votação fora do horário (não use em produção):
VOTACAO_FORCAR_SESSAO=sessao-1

# Modo de teste: voto sem localização e sem OpenCage, salvo no banco separado
# "mostra-2026-teste" do MongoDB (não mistura com os votos oficiais)
# VOTACAO_MODO_TESTE=true
